              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "if (response.token) {",
                  "    pm.environment.set(\"userToken\", response.token);",
                  "    ",
                  "    pm.environment.set(\"token\", response.token);",
                  "    ",
                  "    console.log(\"Login! role: user\");",
                  "}"
